{
  "manifest_version": 3,
  "name": "Hey GPT — Tiếng Việt local",
  "version": "0.6.1",
  "description": "Nghe từ khóa tiếng Việt local, mở Voice trên tab ChatGPT bạn chọn. Không dùng OpenAI API.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "idle"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hey GPT · trạng thái micro local"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "voice-events.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
